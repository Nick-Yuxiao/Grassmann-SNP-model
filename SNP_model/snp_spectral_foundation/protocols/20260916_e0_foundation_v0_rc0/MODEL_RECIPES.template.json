{
  "classification": "PRE_TEST_RECIPE_TEMPLATE",
  "shared_task": {
    "input": "diploid_biallelic_ALT_dosage_with_missing_and_mask_tokens",
    "target_classes": [0, 1, 2],
    "primary_mask_rate": 0.2,
    "loss": "masked_genotype_cross_entropy",
    "loss_region": "core_tokens_only",
    "allele_frequency": "train_families_only_ALT_AF",
    "position_features": [
      "within_window_relative_position",
      "log1p_adjacent_marker_bp_gap",
      "log1p_window_bp_span"
    ],
    "global_block_id_allowed": false,
    "variant_id_lookup_allowed": false,
    "block_specific_parameters_allowed": false
  },
  "recipes": [
    {
      "recipe_id": "E1_PRIMARY_LOCAL_TRANSFORMER",
      "role": "primary",
      "architecture": "pre_norm_transformer_encoder",
      "tokens_per_window": 256,
      "d_model": 128,
      "layers": 4,
      "attention_heads": 8,
      "ff_dim": 512,
      "dropout": 0.1,
      "ancestry_conditioning": false,
      "local_position_mode": "relative_continuous",
      "use_local_block_embedding": false
    },
    {
      "recipe_id": "E2_ANCESTRY_CONDITIONED",
      "role": "secondary_population_adaptation",
      "architecture": "E1_plus_train_PC_FiLM",
      "tokens_per_window": 256,
      "d_model": 128,
      "layers": 4,
      "attention_heads": 8,
      "ff_dim": 512,
      "dropout": 0.1,
      "ancestry_conditioning": "train_fitted_PCs_FiLM",
      "local_position_mode": "relative_continuous",
      "use_local_block_embedding": false
    },
    {
      "recipe_id": "E3_CAPACITY_SENSITIVITY",
      "role": "secondary_capacity_check",
      "architecture": "pre_norm_transformer_encoder",
      "tokens_per_window": 256,
      "d_model": 192,
      "layers": 6,
      "attention_heads": 8,
      "ff_dim": 768,
      "dropout": 0.1,
      "ancestry_conditioning": false,
      "local_position_mode": "relative_continuous",
      "use_local_block_embedding": false
    }
  ],
  "training_budget": {
    "seeds_per_recipe": 3,
    "optimizer": "AdamW",
    "learning_rate": 0.0003,
    "weight_decay": 0.01,
    "warmup_fraction": 0.05,
    "maximum_updates": 100000,
    "validation_every_updates": 1000,
    "early_stopping_patience_evaluations": 10,
    "gradient_clip_norm": 1.0,
    "effective_masked_tokens_per_update": 16384,
    "micro_batch_windows": null,
    "gradient_accumulation_steps": null,
    "precision": null
  },
  "selection": {
    "metric": "validation_family_block_macro_CE",
    "one_standard_error_rule": true,
    "tie_break_order": [
      "lower_validation_CE",
      "smaller_parameter_count",
      "higher_throughput"
    ],
    "test_used_for_selection": false
  },
  "binding_rule": "micro_batch_windows, gradient_accumulation_steps and precision are frozen after a development-only memory/throughput check and before any test access"
}
